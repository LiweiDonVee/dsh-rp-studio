{
  "name": "dsh-rp-studio",
  "version": "1.5.0",
  "description": "DSH RP 聚合工作区与独立管理助手：角色、写作预设、剧情状态与沉浸阅读",
  "license": "MIT",
  "type": "module",
  "main": "dist/host.js",
  "exports": {
    ".": "./dist/host.js",
    "./companion": "./dist/companion.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@dsh-rp/protocol": "workspace:*",
    "@dsh-rp/domain": "workspace:*",
    "@dsh-rp/local-data": "workspace:*",
    "dsh-tavern-renderer": "https://codeload.github.com/LiweiDonVee/dsh-tavern-renderer/tar.gz/f7bbcb3fc90da01345afbbf567bd88e561f75376"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiweiDonVee/dsh-rp-studio.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/LiweiDonVee/dsh-rp-studio#readme",
  "bugs": {
    "url": "https://github.com/LiweiDonVee/dsh-rp-studio/issues"
  }
}
