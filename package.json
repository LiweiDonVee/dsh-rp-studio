{
  "name": "dsh-rp-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start:stack": "node scripts/start-stack.mjs",
    "check:node": "node scripts/check-node-version.mjs",
    "doctor": "pnpm check:node && node scripts/workspace-doctor.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "build": "pnpm clean:build && pnpm -r build",
    "dev": "pnpm --parallel --filter @dsh-rp/gateway --filter @dsh-rp/web dev",
    "desktop:smoke": "pnpm --filter @dsh-rp/desktop build && pnpm --filter @dsh-rp/desktop smoke",
    "desktop:portable": "pnpm --filter @dsh-rp/desktop portable",
    "desktop:package": "pnpm --filter @dsh-rp/desktop package",
    "e2e": "pnpm --filter @dsh-rp/web build && playwright test",
    "lint": "oxlint apps packages tests scripts playwright.config.ts --deny-warnings",
    "smoke:real": "node scripts/real-smoke.mjs",
    "test": "pnpm -r test",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify": "pnpm doctor && pnpm check && pnpm test:integration && pnpm e2e",
    "plugin:build": "node packages/plugin/scripts/build.mjs",
    "plugin:test": "node --test packages/plugin/tests/*.test.mjs",
    "plugin:package": "pnpm plugin:build && node packages/plugin/scripts/pack.mjs",
    "plugin:smoke": "node scripts/native-smoke.mjs",
    "loop:build": "node packages/loop-plugin/scripts/build.mjs",
    "loop:test": "node --test packages/loop-plugin/tests/*.test.mjs",
    "loop:package": "pnpm loop:build && node packages/loop-plugin/scripts/pack.mjs",
    "loop:smoke": "node scripts/loop-smoke.mjs",
    "rp:build": "node packages/rp-last-step/scripts/build.mjs",
    "rp:test": "node --test packages/rp-last-step/tests/*.test.mjs",
    "rp:package": "pnpm rp:build && node packages/rp-last-step/scripts/pack.mjs",
    "rp:smoke": "node scripts/rp-last-step-smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "oxlint": "^1.78.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
