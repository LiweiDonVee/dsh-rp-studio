{
  "name": "dsh-rp-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @dsh-rp/gateway --filter @dsh-rp/web dev",
