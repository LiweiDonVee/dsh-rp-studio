# Export these in the Gateway environment; .env files are not loaded automatically.
DSH_BASE_URL=http://127.0.0.1:3080
# DSH_WEB_TOKEN=
# DSH_HOME defaults to the current user's .dsh directory.
# DSH_HOME=
# Optional Prompt Presets integration: disabled unless a URL is set.
# PROMPT_PRESETS_BASE_URL=http://127.0.0.1:3091/prompt-presets/api
# PROMPT_PRESETS_WEB_TOKEN=
DSH_RP_HOST=127.0.0.1
DSH_RP_PORT=4317
# Optional directory containing a separately built frontend:
# DSH_RP_WEB_DIST=
# Tokens stay server-side. Never set VITE_ token variables or commit real values.
